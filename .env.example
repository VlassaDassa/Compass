# Generate with bash scripts/setup-docker.sh; an existing .env is never replaced.
COMPASS_PUBLIC_URL=https://compass.vlassadassa.ru
COMPASS_APP_PORT=4180
POSTGRES_USER=compass
POSTGRES_DB=compass
# Use a random hexadecimal password; changing it here does not change an existing database.
POSTGRES_PASSWORD=GENERATE_A_RANDOM_HEX_PASSWORD
COMPASS_SECRET=GENERATE_A_RANDOM_HEX_SECRET
COMPASS_AUTH_USER=admin
COMPASS_AUTH_PASSWORD=GENERATE_A_RANDOM_LOGIN_PASSWORD
# Optional trusted SearXNG base URL with JSON API enabled; empty disables web search.
COMPASS_WEB_SEARCH_URL=
# Separate random hex secret required when enabling the optional web-search profile.
COMPASS_SEARCH_SECRET=

