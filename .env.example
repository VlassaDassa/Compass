# Generate a complete .env with npm run setup:vps (does not overwrite existing files).
NODE_ENV=production
HOST=127.0.0.1
PORT=4180
COMPASS_PUBLIC_URL=https://compass.vlassadassa.ru
POSTGRES_USER=compass
POSTGRES_DB=compass
POSTGRES_PASSWORD=GENERATE_A_RANDOM_PASSWORD
COMPASS_POSTGRES_PORT=55432
COMPASS_DATABASE_URL=postgresql://compass:GENERATE_A_RANDOM_PASSWORD@127.0.0.1:55432/compass
# Set true for a remote PostgreSQL service with a trusted TLS certificate.
COMPASS_DB_SSL=false
COMPASS_SECRET=GENERATE_A_RANDOM_64_CHARACTER_SECRET
# Initial private access for the owner. Browser asks for these credentials.
COMPASS_AUTH_USER=admin
COMPASS_AUTH_PASSWORD=GENERATE_A_RANDOM_LOGIN_PASSWORD

